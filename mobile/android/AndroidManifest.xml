<?xml version="1.0" encoding="utf-8"?>
<!-- JARVIS para Android (V4.5): a central do PC no celular, avisos e microfone nativo, na rede de casa. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.patrick.jarvis"
    android:versionCode="46"
    android:versionName="4.5.1">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Microfone para falar com o JARVIS pelo celular (pedido só quando você toca no microfone) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- V6.8.2: "Jarvis, abre a câmera" (câmera do celular na central) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Avisos no celular (lembretes, água, Modo Torcedor) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- V5.1.1: o app baixa a versão nova do PC e se atualiza sozinho (o Android pede permitir uma vez) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- V6.0: entrar no JARVIS com a digital (ou o rosto) do próprio Android -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Android 11+: para enxergar o reconhecimento de voz do Google -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="JARVIS"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pareamento: jarvis://connect?url=http://IP:5173/?token=... (vem da página de pareamento) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jarvis" />
            </intent-filter>
            <!-- V6.0: "Compartilhar -> JARVIS" em qualquer app (texto e links) -->
            <intent-filter android:label="JARVIS">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- V6.0: botão "JARVIS" nas configurações rápidas (cortina do Android) -->
        <service
            android:name=".JarvisTile"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="JARVIS"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".NotifyService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- V5.1.1: resultado da atualização automática (pede confirmação quando o Android exige) -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- V6.5.9: entrega o APK baixado ao instalador do Android (Xiaomi travava na instalação por sessão) -->
        <provider
            android:name=".ApkProvider"
            android:authorities="com.patrick.jarvis.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
