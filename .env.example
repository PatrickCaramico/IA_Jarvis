# ─── Inteligência Artificial ────────────────────────────────────────────────────
# Escolha um provedor: gemini | openai | anthropic
LLM_PROVIDER=gemini

# Preencha a chave do provedor escolhido (os outros podem ficar em branco)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos (opcional — os padrões abaixo já são bons)
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-5-5

# Raciocínio do Gemini: "none" = mais rápido; deixe vazio para ativar o raciocínio completo
GEMINI_REASONING=none
# Ativa pesquisas atualizadas usando Google Search Grounding no Gemini (desligado por padrão para economizar cota)
GEMINI_SEARCH_GROUNDING=false

# Limite de tokens na resposta da IA (respostas curtas = mais rápido)
LLM_MAX_TOKENS=400

# ─── Voz ─────────────────────────────────────────────────────────────────────────
# Vozes disponíveis:
#   pt-BR-AntonioNeural   (masculina — padrão)
#   pt-BR-FranciscaNeural (feminina)
TTS_VOICE=pt-BR-AntonioNeural

# Velocidade da fala: +0% = normal, +10% = mais rápido, -10% = mais lento
TTS_RATE=+0%

# ─── Câmera ──────────────────────────────────────────────────────────────────────
# Índice da câmera: 0 = câmera padrão, 1 = segunda câmera, etc.
CAMERA_INDEX=0

# ─── Reconhecimento Facial ───────────────────────────────────────────────────────
# Similaridade mínima para reconhecer o rosto (0.0 a 1.0). Padrão: 0.363
FACE_THRESHOLD=0.363
# Tempo (segundos) tentando reconhecer antes de desistir
FACE_TIMEOUT=15

# Câmera ao vivo no orbe durante o escaneamento (mais baixo = mais leve)
FACE_STREAM_FPS=10
FACE_STREAM_WIDTH=400
FACE_STREAM_QUALITY=65

# ─── Clima ───────────────────────────────────────────────────────────────────────
# Cidade usada quando você não especificar uma
WEATHER_CITY=São Paulo

# ─── Notícias ────────────────────────────────────────────────────────────────────
# Quantas notícias mostrar no resumo do dia
NEWS_LIMIT=3

# ─── Usuário ─────────────────────────────────────────────────────────────────────
# Nome padrão (substitui se não houver foto de perfil cadastrada)
USER_NAME=

# ─── Avisos enquanto a IA processa ───────────────────────────────────────────────
# Segundos até o primeiro aviso "só um minutinho..." (0 = desligado)
FILLER_FIRST_DELAY=6
# Intervalo entre avisos subsequentes (segundos)
FILLER_INTERVAL=20

# ─── Modo de Rede Local (avançado) ───────────────────────────────────────────────
# Define se o JARVIS aceita conexões de outros dispositivos na mesma rede Wi-Fi (0.0.0.0 com token)
JARVIS_NETWORK_MODE=false

# ─── Modo nuvem (V6.6): usar o JARVIS no celular com o notebook desligado ─────────
# A MESMA senha longa que você colocou em JARVIS_NUVEM_CHAVE no painel do Netlify.
# Com ela, o PC busca o que você mudou pelo celular (compras, tarefas, lembretes, alarmes, água) e
# manda as listas dele para a nuvem a cada minuto. Vazio = sem sincronização. Guia: docs/MODO-NUVEM.md
JARVIS_NUVEM_CHAVE=
# Endereço do site (só mude se o seu site do Netlify tiver outro nome)
# JARVIS_NUVEM_URL=https://projeto-jarvis-ia.netlify.app

# ─── CORS Extra (avançado) ───────────────────────────────────────────────────────
# Origens extras permitidas, separadas por vírgula
# EXTRA_CORS_ORIGINS=http://192.168.1.100:5173

# --- Google Calendar OAuth 2.0 ---
# Crie um cliente OAuth "Aplicativo para computador" no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Triagem de e-mail no "bom dia" (opcional, somente leitura) ──────────────────
# Gmail: imap.gmail.com + uma "senha de app" (não use a senha normal da conta)
EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_LOOKBACK_HOURS=24

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/spotify/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google-calendar/callback
